# syntax=docker/dockerfile:1
# Generated by dev.slne.surf.microservice (generateMicroserviceDockerfile).
# Manual changes are lost the next time this file is generated.

# Stage 1: build the runnable application JAR with Gradle.
FROM eclipse-temurin:25-jdk AS build
WORKDIR /workspace
COPY . .
RUN chmod +x gradlew && ./gradlew :surf-parkour-microservice:prepareMicroserviceDockerArtifact --no-daemon

# Stage 2: compile the native microservicectl command client.
FROM golang:1.26-alpine AS command-client-build
WORKDIR /src
COPY --from=build /workspace/surf-parkour-microservice/build/generated/microservicectl/main.go /src/main.go
RUN mkdir -p /out \
    && CGO_ENABLED=0 go build \
        -buildvcs=false \
        -trimpath \
        -ldflags='-s -w' \
        -o /out/microservicectl \
        /src/main.go

# Stage 3: assemble the runtime image.
FROM eclipse-temurin:25-jre

# Run the application as an unprivileged user that owns /app.
RUN groupadd --system --gid 10001 app \
    && useradd --system \
        --uid 10001 \
        --gid app \
        --home-dir /app \
        --create-home \
        app

# Install the application JAR and the command client.
WORKDIR /app
COPY --from=build --chown=app:app /workspace/surf-parkour-microservice/build/docker/app.jar /app/app.jar
COPY --from=command-client-build /out/microservicectl /usr/local/bin/microservicectl

# Additional JVM flags. The entrypoint always applies:
#   -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
ENV JAVA_OPTS=""

# Unix socket used by microservicectl to reach the running application.
ENV SURF_MICROSERVICE_COMMAND_SOCKET=/app/run/microservice.sock

# Start the application; arguments passed to the container are forwarded to it.
USER app
ENTRYPOINT ["sh", "-c", "exec java -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError $JAVA_OPTS -jar /app/app.jar \"$@\"", "--"]
