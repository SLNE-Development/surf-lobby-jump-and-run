# syntax=docker/dockerfile:1
# Generated by dev.slne.surf.microservice (generateMicroserviceDockerfile).
FROM eclipse-temurin:25-jdk AS build
WORKDIR /workspace
COPY . .
RUN chmod +x gradlew && ./gradlew :surf-parkour-microservice:prepareMicroserviceDockerArtifact --no-daemon
FROM eclipse-temurin:25-jre
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --home-dir /app --create-home app
WORKDIR /app
COPY --from=build --chown=app:app /workspace/surf-parkour-microservice/build/docker/app.jar /app/app.jar
ENV JAVA_OPTS=""
ENV SURF_MICROSERVICE_COMMAND_SOCKET=/app/run/microservice.sock
#
# RabbitMQ runtime environment (configure in Coolify; values are not embedded):
# - SURF_RABBITMQ_HOST: RabbitMQ service host
# - SURF_RABBITMQ_PORT: RabbitMQ service port
# - SURF_RABBITMQ_USERNAME: RabbitMQ username; configure as a secret
# - SURF_RABBITMQ_PASSWORD: RabbitMQ password; configure as a secret
# - SURF_RABBITMQ_VHOST: RabbitMQ virtual host
# - SURF_RABBITMQ_TIMEOUT: connection timeout in seconds
# - SURF_RABBITMQ_REQUEST_TIMEOUT_SECONDS: request timeout in seconds
# - SURF_RABBITMQ_PUBLISHER_POOL_SIZE: publisher worker count
# - SURF_RABBITMQ_SERVER_PREFETCH_COUNT: server prefetch count
# - SURF_RABBITMQ_PERSIST_REQUESTS: whether requests are persistent
# - SURF_RABBITMQ_PERSIST_RESPONSES: whether responses are persistent
# - SURF_RABBITMQ_OUTGOING_REQUEST_CHUNKING_ENABLED: whether outgoing requests may be chunked
# - SURF_RABBITMQ_OUTGOING_RESPONSE_CHUNKING_ENABLED: whether outgoing responses may be chunked
#
# Database runtime environment (configure in Coolify; values are not embedded):
# - SURF_DATABASE_LOG_LEVEL: database SQL log level
# - SURF_DATABASE_TYPE: mariadb or postgresql
# - SURF_DATABASE_SCHEMA: PostgreSQL schema
# - SURF_DATABASE_HOST: database service host
# - SURF_DATABASE_PORT: database service port
# - SURF_DATABASE_NAME: database name
# - SURF_DATABASE_USERNAME: database username; configure as a secret
# - SURF_DATABASE_PASSWORD: database password; configure as a secret
# - SURF_DATABASE_POOL_INITIAL_SIZE: initial connection count
# - SURF_DATABASE_POOL_MIN_IDLE: minimum idle connection count
# - SURF_DATABASE_POOL_MAX_SIZE: maximum connection count
# - SURF_DATABASE_POOL_MAX_ACQUIRE_TIME_MILLIS: maximum acquisition time in milliseconds
# - SURF_DATABASE_POOL_MAX_CREATE_CONNECTION_TIME_MILLIS: maximum connection creation time in milliseconds
# - SURF_DATABASE_POOL_MAX_VALIDATION_TIME_MILLIS: maximum validation time in milliseconds
# - SURF_DATABASE_POOL_MAX_IDLE_TIME_MILLIS: maximum idle time in milliseconds
# - SURF_DATABASE_POOL_MAX_LIFE_TIME_MILLIS: maximum connection lifetime in milliseconds
RUN printf '%s\n' \
'#!/bin/sh' \
'exec java -Xms8m -Xmx64m -XX:+ExitOnOutOfMemoryError -jar /app/app.jar __surf-command "$@"' \
> /usr/local/bin/microservicectl \
&& chmod 0555 /usr/local/bin/microservicectl
USER app
ENTRYPOINT ["sh", "-c", "exec java -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError $JAVA_OPTS -jar /app/app.jar \"$@\"", "--"]
